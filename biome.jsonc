{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "formatter": {
    "lineWidth": 120
  },
  "linter": {
    "rules": {
      "performance": {
        // React Compiler stabilizes JSX callbacks where doing so is useful.
        "noJsxPropsBind": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "sortBareImports": true,
            "groups": [
              {
                "type": false
              },
              {
                "type": true
              }
            ]
          }
        }
      }
    }
  }
}
